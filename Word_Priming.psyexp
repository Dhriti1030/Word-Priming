  <Flow>
    <Routine name="Instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'Study_word': 'book'}, {'Study_word': 'cushion'}, {'Study_word': 'phone'}, {'Study_word': 'marble'}, {'Study_word': 'board'}, {'Study_word': 'Laptop'}, {'Study_word': 'Chart'}, {'Study_word': 'T-shirt'}, {'Study_word': 'mouse'}, {'Study_word': 'Pastry'}, {'Study_word': 'Case'}, {'Study_word': 'Cruise'}, {'Study_word': 'Police'}, {'Study_word': 'Keys'}, {'Study_word': 'Poster'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="study_conditions.csv" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="StudyPhase"/>
    <LoopTerminator name="trials"/>
    <Routine name="TestInstructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials_2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'test_word': 'l_pt_p', 'Reference': 'Laptop', 'old_new': 'old'}, {'test_word': '_ha_t', 'Reference': 'Chart', 'old_new': 'old'}, {'test_word': 'T_hi_t', 'Reference': 'Tshirt', 'old_new': 'old'}, {'test_word': '_ou_e', 'Reference': 'mouse', 'old_new': 'old'}, {'test_word': 'P_st_y', 'Reference': 'Pastry', 'old_new': 'old'}, {'test_word': 'c_s_', 'Reference': 'Case', 'old_new': 'old'}, {'test_word': '_ru_s_', 'Reference': 'Cruise', 'old_new': 'old'}, {'test_word': 'P_li_e', 'Reference': 'Police', 'old_new': 'old'}, {'test_word': 'K_y_', 'Reference': 'Keys', 'old_new': 'old'}, {'test_word': 'P_st_r', 'Reference': 'Poster', 'old_new': 'old'}, {'test_word': '_o_rd', 'Reference': 'Board', 'old_new': 'old'}, {'test_word': '_a_bl_', 'Reference': 'Marble', 'old_new': 'old'}, {'test_word': '_ho_e', 'Reference': 'Phone', 'old_new': 'old'}, {'test_word': '_oo_', 'Reference': 'Book', 'old_new': 'old'}, {'test_word': 'c_s_io_', 'Reference': 'Cushion', 'old_new': 'old'}, {'test_word': 'ta_l_', 'Reference': 'Table', 'old_new': 'new'}, {'test_word': 'p_nc_l', 'Reference': 'Pencil', 'old_new': 'new'}, {'test_word': 'v_s_', 'Reference': 'Vase', 'old_new': 'new'}, {'test_word': 'bo_t_e', 'Reference': 'Bottle', 'old_new': 'new'}, {'test_word': 'c_m_ra', 'Reference': 'Camera', 'old_new': 'new'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="test_conditions.csv" valType="str"/>
      <Param name="endPoints" updates="None" val="[2, 3]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="TestPhase"/>
    <LoopTerminator name="trials_2"/>
  </Flow>
</PsychoPy2experiment>
